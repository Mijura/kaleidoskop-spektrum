{
	"name": "kaleidoskop",
	"description": "Observability microservice",
	"version": "0.0.1",
	"private": true,
	"dependencies": {
		"@aws-sdk/client-dynamodb": "^3.398.0",
		"@aws-sdk/lib-dynamodb": "^3.398.0",
		"uuid": "^13.0.0"
	},
	"devDependencies": {
		"@rstest/core": "^0.7.9",
		"@rstest/coverage-istanbul": "^0.1.6",
		"@types/aws-lambda": "^8.10.159",
		"aws-sdk-client-mock": "^2.0.0",
		"dotenv": "^17.2.3",
		"esbuild": "^0.27.0",
		"npm-run-all": "^4.1.5",
		"prettier": "^3.7.4",
		"swagger-ui-watcher": "^2.1.14"
	},
	"scripts": {
		"build:local": "sam build --template template.local.yaml --profile Development",
		"serve:local": "sam local start-api --profile Development -t .aws-sam/build/template.yaml --port 9000 --region eu-west-1 --env-vars env.json",
		"build:dev": "sam build --profile Development",
		"deploy:dev": "sam deploy --profile Development --capabilities CAPABILITY_NAMED_IAM CAPABILITY_AUTO_EXPAND",
		"docs": "npx swagger-ui-watcher openapi.yaml --port 9090",
		"dev": "npm-run-all --parallel serve docs",
		"format": "prettier --write \"src/**/*.{ts,tsx}\"",
		"test": "rstest -c rstest.config.ts",
		"coverage": "rstest --coverage"
	}
}
