{
	"name": "kaleidoskop-spektrum",
	"description": "Spektrum platform observability microservice. (The kaleidoskop name was renamed when the JigJoy replay tool inherited it; see github.com/jigjoy-ai/kaleidoskop.)",
	"version": "0.0.1",
	"private": true,
	"dependencies": {
		"@aws-sdk/client-dynamodb": "^3.996.0",
		"@aws-sdk/lib-dynamodb": "^3.996.0",
		"@heksagon/app": "^0.0.14",
		"@heksagon/http": "^0.0.9",
		"@jigjoy-ai/auth": "^0.1.0",
		"@jigjoy-ai/serverless-core": "^0.0.5",
		"uuid": "^13.0.0"
	},
	"devDependencies": {
		"@rstest/core": "^0.8.5",
		"@rstest/coverage-istanbul": "^0.2.1",
		"@types/aws-lambda": "^8.10.160",
		"aws-sdk-client-mock": "^4.1.0",
		"dotenv": "^17.3.1",
		"esbuild": "^0.27.3",
		"npm-run-all": "^4.1.5",
		"prettier": "^3.8.1",
		"swagger-ui-watcher": "^2.1.14"
	},
	"scripts": {
		"build:local": "sam build --template template.local.yaml --profile spektrum-dev",
		"serve:local": "sam local start-api --profile spektrum-dev -t .aws-sam/build/template.yaml --port 9000 --region eu-west-1 --env-vars env.json",
		"build:dev": "sam build --profile spektrum-dev",
		"deploy:dev": "sam deploy --profile spektrum-dev --capabilities CAPABILITY_NAMED_IAM CAPABILITY_AUTO_EXPAND",
		"docs": "npx swagger-ui-watcher openapi.yaml --port 9090",
		"dev": "npm-run-all --parallel serve docs",
		"format": "prettier --write \"src/**/*.{ts,tsx}\"",
		"test": "rstest -c rstest.config.ts",
		"coverage": "rstest --coverage"
	}
}
